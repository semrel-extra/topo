{
  "compilerOptions": {
    "rootDir": "./src/main/ts/",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "esnext",
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/test"
  ]
}
